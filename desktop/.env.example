# Desktop main-process runtime configuration. Do not commit real tokens.
COPILOT_DESKTOP_ENVIRONMENT=development
COPILOT_API_BASE_URL=http://127.0.0.1:8765
# Optional: omitted values are derived from COPILOT_API_BASE_URL.
COPILOT_WS_URL=ws://127.0.0.1:8765/ws
COPILOT_LOCAL_AUTH_TOKEN=replace-with-the-backend-token

# Production example:
# COPILOT_DESKTOP_ENVIRONMENT=production
# COPILOT_API_BASE_URL=https://your-render-service.onrender.com
# COPILOT_WS_URL=wss://your-render-service.onrender.com/ws