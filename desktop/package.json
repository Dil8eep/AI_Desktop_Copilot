{
  "name": "@copilot/desktop",
  "version": "0.1.1",
  "private": true,
  "main": "dist/electron/main/index.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\" \"npm:dev:main\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:main": "tsc --watch --preserveWatchOutput -p tsconfig.electron.json",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env COPILOT_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run typecheck && npm run build:renderer && npm run verify:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint src tests --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build:helper": "cd ../backend && .venv\\Scripts\\python.exe -m PyInstaller --clean --noconfirm --distpath dist/local-helper local-helper.spec",
    "pack:win": "npm run build:helper && npm run build && electron-builder --win dir",
    "dist:win": "npm run build:helper && npm run build && electron-builder --win nsis",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:renderer": "node scripts/verify-renderer-assets.mjs"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "36.9.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "highlight.js": "^11.11.1",
    "prettier": "^3.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.dileep.aidesktopcopilot",
    "productName": "AI Desktop Copilot",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/local-helper/copilot-local-helper.exe",
        "to": "local-helper/copilot-local-helper.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signExecutable": false,
      "artifactName": "AI-Desktop-Copilot-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AI Desktop Copilot",
      "deleteAppDataOnUninstall": false
    }
  },
  "description": "Windows AI interview and meeting copilot with local capture",
  "author": "Dileep Kumar Marri"
}
