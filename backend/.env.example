COPILOT_JWT_SECRET=replace-with-a-unique-32-plus-character-secret
COPILOT_JWT_ACCESS_TOKEN_MINUTES=15
COPILOT_JWT_REFRESH_TOKEN_DAYS=30
COPILOT_DATABASE_URL=postgresql+asyncpg://copilot_user:change-this-password@127.0.0.1:5434/ai_desktop_copilot
# The backend is intentionally loopback-only by default.
COPILOT_BACKEND_HOST=127.0.0.1
COPILOT_BACKEND_PORT=8765

# Generate a unique local value per desktop launch in the Electron main process.
# Do not commit a real value.
COPILOT_LOCAL_AUTH_TOKEN=replace-at-runtime

# Provider credentials are backend-only. Never commit real keys.
# Generate one AES-256 key per deployment and store it in the host secret manager.
COPILOT_CREDENTIAL_MASTER_KEY=
COPILOT_CREDENTIAL_CACHE_SECONDS=15
COPILOT_LLM_PROVIDER=openai
COPILOT_OPENAI_MODEL=gpt-4.1-mini
COPILOT_AUTO_RESPOND_TO_SPEECH=true
# Terminal-only diagnostics. Disable to avoid printing consented transcript text.
COPILOT_CONSOLE_TRANSCRIPT_LOGGING=true

COPILOT_SPEECH_PROVIDER=groq
COPILOT_GROQ_WHISPER_MODEL=whisper-large-v3
COPILOT_MOCK_LLM_TOKEN_DELAY_MS=20

COPILOT_OCR_PROVIDER=liteparse
# LiteParse uses its bundled Tesseract OCR engine.
