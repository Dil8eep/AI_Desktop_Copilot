# Render values. Never commit real values.
COPILOT_ENVIRONMENT=production
COPILOT_FORCE_HTTPS=true
COPILOT_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@NEON_HOST/DATABASE?ssl=require
COPILOT_JWT_SECRET=GENERATE_A_UNIQUE_32_PLUS_CHARACTER_SECRET
COPILOT_LOCAL_AUTH_TOKEN=GENERATE_A_DIFFERENT_32_PLUS_CHARACTER_SECRET
COPILOT_CREDENTIAL_MASTER_KEY=GENERATE_A_BASE64_ENCODED_32_BYTE_KEY
COPILOT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
COPILOT_CORS_ORIGINS=https://your-admin-portal.vercel.app
COPILOT_ALLOWED_HOSTS=your-render-service.onrender.com
COPILOT_CONSOLE_TRANSCRIPT_LOGGING=false
